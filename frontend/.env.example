# Copy this file to ".env" and add your TMDB API key.
# Vite only exposes env vars prefixed with VITE_ to the browser.
# Get a key (free) at https://www.themoviedb.org/settings/api
#
# NOTE: restart the dev server after editing .env -- Vite reads env vars at
# startup. If this is left blank, MovieCard falls back to colored placeholders.
VITE_TMDB_API_KEY=
