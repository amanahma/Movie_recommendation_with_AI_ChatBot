# Copy this file to ".env" and fill in real values.
# The .env file is git-ignored so secrets never get committed.

# PostgreSQL connection string.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/moviedb

# Used later for signing JWT auth tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Groq powers the LLM features (added in a later phase). Groq's API is
# OpenAI-compatible, so we use the OpenAI SDK pointed at Groq's endpoint.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq's OpenAI-compatible base URL (rarely needs changing).
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Which Groq-hosted model to use for generating descriptions.
GROQ_MODEL=llama-3.3-70b-versatile

# TMDB key for scripts/import_movies.py (backend-side, no VITE_ prefix).
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
